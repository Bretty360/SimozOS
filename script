# Vytvoří globální šablonu pro MPV
mkdir -p /etc/skel/.config/mpv

# sekce setup drivers
# Vytvoří soubor mpv.conf s univerzálním nastavením
cat << EOF > /etc/skel/.config/mpv/mpv.conf
hwdec=auto-safe
vo=gpu
EOF

# práva
sudo su

# rdp vzdalena plocha
sudo apt update
sudo apt install xrdp
sudo systemctl enable --now xrdp

# správa pameti 
sudo apt install zram-tools -y
sudo nano /etc/default/zram-tools

# vlozit do souboru:
# Nastaví velikost ZRAM na 50 % celkové kapacity RAM počítače
PERCENT=50
# Použije moderní a velmi rychlý kompresní algoritmus zstd
ALGORITHM=zstd




# swap 
sudo nano /etc/sysctl.conf

# vlozit do souboru:
# Systém začne swapovat až při opravdu vysokém využití RAM
vm.swappiness=10
# Vylepší kešování souborového systému
vm.vfs_cache_pressure=50



